<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same, for cloud backup and for moving to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="clips/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="clips/" />
    </device-transfer>
</data-extraction-rules>
